{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://einsoft-gp-sfrntnd.vercel.app",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "https://einsoft-gp-sfrntnd.vercel.app/dashboard",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "https://einsoft-gp-sfrntnd.vercel.app/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "/api"
    },
    {
      "source": "/eyenode/(.*)",
      "destination": "/api"
    },
    {
      "source": "/eyenode",
      "destination": "/api"
    },
    {
      "source": "/tracker/(.*)",
      "destination": "/api"
    },
    {
      "source": "/tracker",
      "destination": "/api"
    },
    {
      "source": "/sw.js",
      "destination": "/api"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/api"
    }
  ]
}